<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CommonPluginsControls.Controls">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="SsvActiveSourceRowTemplate">
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <controls:TextBlockTrimmed Style="{DynamicResource ListBoxExtendStyleTextBlock}"
                                           Text="{Binding ScreenshotsFolder}" />

                <controls:TextBlockTrimmed Style="{DynamicResource ListBoxExtendStyleTextBlockDarker}"
                                           Margin="0,2,0,0"
                                           Text="{Binding FilePatternSummary}"
                                           Visibility="{Binding ShowFilePatternSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:TextBlockTrimmed Style="{DynamicResource ListBoxExtendStyleTextBlockDarker}"
                                           Margin="0,2,0,0"
                                           Text="{Binding ScanSubFoldersSummary}"
                                           Visibility="{Binding ShowScanSubFoldersSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:TextBlockTrimmed Style="{DynamicResource ListBoxExtendStyleTextBlockDarker}"
                                           Margin="0,2,0,0"
                                           Text="{Binding ApplicabilitySummary}"
                                           Visibility="{Binding ShowApplicabilitySummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Archive: PlayniteBase save glyph &#xee00; · Conversion: Media UpdateDbIcon &#xefd1; -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           FontFamily="{DynamicResource FontIcoFont}"
                           FontWeight="Light"
                           FontSize="{DynamicResource FontSize}"
                           Foreground="{DynamicResource GlyphBrush}"
                           Text="&#xee00;"
                           Opacity="{Binding ArchiveOperationOpacity}"
                           ToolTip="{Binding ArchiveOperationToolTip}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           FontFamily="{DynamicResource FontIcoFont}"
                           FontWeight="Light"
                           FontSize="{DynamicResource FontSize}"
                           Foreground="{DynamicResource GlyphBrush}"
                           Text="&#xefd1;"
                           Opacity="{Binding ConversionOperationOpacity}"
                           ToolTip="{Binding ConversionOperationToolTip}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="4"
                    VerticalAlignment="Center"
                    Style="{DynamicResource ListRowHoverRevealIconButton}"
                    FontFamily="{DynamicResource CommonFont}"
                    Content="&#xe97f;"
                    ToolTip="{DynamicResource LOCCommonRemoveFolder}"
                    Command="{Binding DataContext.ConfigurationContext.RemoveActiveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
